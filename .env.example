# ─────────────────────────────────────────────────────────────
# Frontend (public site) — used by the Next.js build
# ─────────────────────────────────────────────────────────────
# URL of the FastAPI backend. Can point at a gateway, a mirror, or be left
# empty to run purely from the bundled IPFS snapshot.
NEXT_PUBLIC_API_URL=https://api.missingpersons-tz.org
# Public IPFS gateway used to build mirror links in the footer
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# Armored PGP public key of the server (used to encrypt reports in-browser).
# Also copied to public/keys/server-pub.asc
NEXT_PUBLIC_PGP_PUBLIC_KEY_URL=/keys/server-pub.asc

# ─────────────────────────────────────────────────────────────
# PART 2 — Deployment scripts (CI secrets; never commit real values)
# ─────────────────────────────────────────────────────────────
PINATA_JWT=your-pinata-jwt-here
ENS_DOMAIN=missingpersons-tz.eth
ENS_PRIVATE_KEY=your-eth-deployer-private-key
ENS_RESOLVER_ADDRESS=0x231b0Ee14048e9dCcD1d247744d114a4EB5E8E63
ARWEAVE_WALLET_PATH=./wallet.json
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ─────────────────────────────────────────────────────────────
# Backend (FastAPI + Celery + bot) — see docker-compose.yml
# ─────────────────────────────────────────────────────────────
DB_PASSWORD=change-me-strong
DATABASE_URL=postgresql://mp:change-me-strong@postgres/missing_persons
REDIS_URL=redis://redis:6379/0
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
# PGP keypair generated offline; public key copied to bot/keys and public/keys
PGP_PUBLIC_KEY_FILE=/keys/server-pub.asc
PGP_PRIVATE_KEY_FILE=/keys/server-priv.asc
PGP_PASSPHRASE=change-me
# Signal bot
BOT_NUMBER=+2557XXXXXXXX
SIGNAL_API=http://signal-cli-rest-api:8080
FASTAPI_URL=http://fastapi:8000
# Comma-separated admin Signal numbers for daily OSINT digests
ALERT_SIGNAL_NUMBERS=+2557YYYYYYYY1,+2557YYYYYYYY2
